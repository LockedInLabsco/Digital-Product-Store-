# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend Email Configuration (Required for emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@not4normal.store

# Paddle Configuration (Required for paid products)
PADDLE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxx
PADDLE_WEBHOOK_SECRET=pdl_wh_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Notes:
# - SUPABASE_SERVICE_ROLE_KEY: Server-side only, for generating signed URLs
# - PADDLE_API_KEY: Server-side only, never expose to browser
# - PADDLE_WEBHOOK_SECRET: Server-side only, for webhook verification
# - NEXT_PUBLIC_*: Frontend-safe, will be visible in browser
