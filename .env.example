# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend Email Configuration (Required for free and paid delivery emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=hello@not4normal.store

# App Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_EMAIL=admin@not4normal.store
ADMIN_PASSWORD=your_secure_admin_password

# Paddle Configuration (Required for paid products)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_sandbox_client_token_here
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=your_sandbox_api_key_here
PADDLE_WEBHOOK_SECRET=your_sandbox_webhook_secret_here

# Legacy Lemon Squeezy Configuration (not used by current Paddle checkout)
# Keep these unset unless you intentionally re-enable the legacy Lemon Squeezy integration.
# LEMON_SQUEEZY_API_KEY=
# NEXT_PUBLIC_LEMON_SQUEEZY_STORE_ID=

# Notes:
# - SUPABASE_SERVICE_ROLE_KEY: Server-side only, for signed downloads and admin data access.
# - PADDLE_API_KEY: Server-side only. Never expose it in browser code.
# - PADDLE_WEBHOOK_SECRET: Server-side only, for Paddle webhook verification.
# - NEXT_PUBLIC_* variables are visible in the browser bundle.
# - Use sandbox Paddle client token/API key/webhook secret with sandbox pri_ price IDs.
# - Use production Paddle client token/API key/webhook secret with live pri_ price IDs.
